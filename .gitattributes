# Repo history is already fully LF; keep it that way and check out LF too,
# so the working tree stops drifting into mixed CRLF/LF on Windows.
* text=auto eol=lf

# Binary assets — never touch line endings
*.webp binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.wasm binary
*.bin binary
*.onnx binary
